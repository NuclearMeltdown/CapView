#include "resource.h"
#include <windows.h>

// Lowest id wins in Explorer, so this is the file icon as well as the window icon.
IDI_CAPVIEW ICON "capview.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 3, 5, 0, 0
PRODUCTVERSION 3, 5, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "CapView"
            VALUE "FileVersion", "3.5.0.0"
            VALUE "InternalName", "CapView"
            VALUE "OriginalFilename", "CapView.exe"
            VALUE "ProductName", "CapView"
            VALUE "ProductVersion", "3.5.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
