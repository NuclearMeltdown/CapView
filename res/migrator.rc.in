// Generated from this template by CMake -- see the migrator section of
// CMakeLists.txt. Everything in here is written out in full rather than taken
// from the project name, because this file is the one thing in the build that
// must keep saying "CapView" after the program has stopped being called that.

#include "resource.h"
#include <windows.h>

// The icon is the current one: this window belongs to the program that is
// arriving, not to the one it replaces. Only the strings below stay old, and
// they stay old because Windows shows them for the file being replaced.
IDI_QBLANK ICON "qblank.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "FileDescription", "CapView"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "CapView"
            VALUE "OriginalFilename", "CapView.exe"
            VALUE "ProductName", "CapView"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
