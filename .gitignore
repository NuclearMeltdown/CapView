# Build output. Everyone builds their own with build.bat, or takes a release.
build/
/CapView.exe
/capview_vcam.dll
# Written out of the exe when the camera is installed; the hash is per build.
/capview_vcam_*.dll
/capview_vcam.dll.old*
/capview_probe.exe

# Settings are per machine and hold device names and paths.
CapView.json
CapView.json.bak*
CapView.log

# ffmpeg is downloaded from upstream at runtime, never committed: it is ~100 MB
# and the usual Windows builds are GPL.
ffmpeg/

# Visual Studio / editors
.vs/
*.user
*.vcxproj*
CMakeSettings.json
.cache/
compile_commands.json

# Python helper leftovers in tools/
__pycache__/
*.pyc

# Compiled shaders, written next to the exe on first run. Keyed by a hash of the
# source, so they are regenerated whenever the shader changes.
shader-*.cso
